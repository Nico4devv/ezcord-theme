  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#676e95",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted"],
      "settings": {
        "foreground": "#c3e88d"
      }
    },
    {
      "name": "Template String",
      "scope": ["string.template"],
      "settings": {
        "foreground": "#c3e88d"
      }
    },
    {
      "name": "Template Expression",
      "scope": ["punctuation.definition.template-expression"],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#f78c6c"
      }
    },
    {
      "name": "Boolean",
      "scope": ["constant.language.boolean"],
      "settings": {
        "foreground": "#f78c6c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Null / Undefined",
      "scope": ["constant.language.null", "constant.language.undefined"],
      "settings": {
        "foreground": "#f78c6c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Constant",
      "scope": ["constant.language", "constant.character"],
      "settings": {
        "foreground": "#f78c6c"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control"],
      "settings": {
        "foreground": "#c792ea",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#c792ea",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "Function Call",
      "scope": ["meta.function-call.generic"],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "Class",
      "scope": ["entity.name.class", "support.class", "entity.name.type.class"],
      "settings": {
        "foreground": "#ffcb6b"
      }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "support.type"],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "Interface",
      "scope": ["entity.name.type.interface"],
      "settings": {
        "foreground": "#89ddff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other"],
      "settings": {
        "foreground": "#d0d0e8"
      }
    },
    {
      "name": "Variable Parameter",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#d0d0e8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable Language (self, this)",
      "scope": ["variable.language"],
      "settings": {
        "foreground": "#c792ea",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property", "support.variable.property"],
      "settings": {
        "foreground": "#b2ccd6"
      }
    },
    {
      "name": "Decorator",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.definition.decorator"],
      "settings": {
        "foreground": "#82aaff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Import / From",
      "scope": ["keyword.control.import", "keyword.control.from"],
      "settings": {
        "foreground": "#c792ea",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#f07178"
      }
    },
    {
      "name": "Tag Punctuation",
      "scope": ["punctuation.definition.tag"],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#ffcb6b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation"],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "Punctuation Accessor",
      "scope": ["punctuation.accessor", "punctuation.separator.dot-access"],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#f07178",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Support Constant",
      "scope": ["support.constant"],
      "settings": {
        "foreground": "#f78c6c"
      }
    },
    {
      "name": "JSON Key Level 0",
      "scope": ["source.json meta.structure.dictionary.json support.type.property-name.json"],
      "settings": {
        "foreground": "#f07178"
      }
    },
    {
      "name": "JSON Key Level 1",
      "scope": ["source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"],
      "settings": {
        "foreground": "#c792ea"
      }
    },
    {
      "name": "JSON Key Level 2",
      "scope": ["source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "CSS Property",
      "scope": ["support.type.property-name.css", "support.type.vendored.property-name.css"],
      "settings": {
        "foreground": "#b2ccd6"
      }
    },
    {
      "name": "CSS Value",
      "scope": ["support.constant.property-value.css"],
      "settings": {
        "foreground": "#c3e88d"
      }
    },
    {
      "name": "CSS Selector",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": {
        "foreground": "#ffcb6b"
      }
    },
    {
      "name": "Markdown Heading",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": {
        "foreground": "#82aaff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#ffcb6b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#c792ea",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#c3e88d"
      }
    },
    {
      "name": "Markdown Link",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#89ddff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#676e95",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#c3e88d",
    "type": "#89ddff",
    "type.declaration": { "foreground": "#ffcb6b" },
    "class": "#ffcb6b",
    "class.declaration": { "foreground": "#ffcb6b" },
    "enum": "#f78c6c",
    "interface": { "foreground": "#89ddff", "fontStyle": "italic" },
    "typeParameter": "#89ddff",
    "parameter": { "foreground": "#d0d0e8", "fontStyle": "italic" },
    "variable": "#d0d0e8",
    "variable.readonly": { "foreground": "#f78c6c" },
    "variable.defaultLibrary": "#89ddff",
    "property": "#b2ccd6",
    "property.readonly": { "foreground": "#f78c6c" },
    "property.declaration": "#b2ccd6",
    "enumMember": "#f78c6c",
    "event": "#82aaff",
    "function": "#82aaff",
    "function.defaultLibrary": "#89ddff",
    "method": "#82aaff",
    "macro": "#c792ea",
    "keyword": { "foreground": "#c792ea", "fontStyle": "italic" },
    "modifier": { "foreground": "#c792ea", "fontStyle": "italic" },
    "comment": { "foreground": "#676e95", "fontStyle": "italic" },
    "string": "#c3e88d",
    "number": "#f78c6c",
    "regexp": "#89ddff",
    "operator": "#89ddff",
    "decorator": { "foreground": "#82aaff", "fontStyle": "italic" },
    "parameter.declaration": { "foreground": "#d0d0e8", "fontStyle": "italic" }
  }
}