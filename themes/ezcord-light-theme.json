  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#909aa8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted"],
      "settings": {
        "foreground": "#1e7a44"
      }
    },
    {
      "name": "Template String",
      "scope": ["string.template"],
      "settings": {
        "foreground": "#1e7a44"
      }
    },
    {
      "name": "Template Expression",
      "scope": ["punctuation.definition.template-expression"],
      "settings": {
        "foreground": "#0070aa"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#b06000"
      }
    },
    {
      "name": "Boolean",
      "scope": ["constant.language.boolean"],
      "settings": {
        "foreground": "#b5006e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Null / Undefined",
      "scope": ["constant.language.null", "constant.language.undefined"],
      "settings": {
        "foreground": "#b5006e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Constant",
      "scope": ["constant.language", "constant.character"],
      "settings": {
        "foreground": "#b5006e"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control"],
      "settings": {
        "foreground": "#7c3aed",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#7c3aed",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#0070aa"
      }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#0070aa"
      }
    },
    {
      "name": "Function Call",
      "scope": ["meta.function-call.generic"],
      "settings": {
        "foreground": "#0070aa"
      }
    },
    {
      "name": "Class",
      "scope": ["entity.name.class", "support.class", "entity.name.type.class"],
      "settings": {
        "foreground": "#b06000"
      }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "support.type"],
      "settings": {
        "foreground": "#0094a8"
      }
    },
    {
      "name": "Interface",
      "scope": ["entity.name.type.interface"],
      "settings": {
        "foreground": "#0094a8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other"],
      "settings": {
        "foreground": "#2c2f36"
      }
    },
    {
      "name": "Variable Parameter",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#2c2f36",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable Language (self, this)",
      "scope": ["variable.language"],
      "settings": {
        "foreground": "#7c3aed",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property", "support.variable.property"],
      "settings": {
        "foreground": "#3a6680"
      }
    },
    {
      "name": "Decorator",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.definition.decorator"],
      "settings": {
        "foreground": "#0070aa",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Import / From",
      "scope": ["keyword.control.import", "keyword.control.from"],
      "settings": {
        "foreground": "#7c3aed",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#b5006e"
      }
    },
    {
      "name": "Tag Punctuation",
      "scope": ["punctuation.definition.tag"],
      "settings": {
        "foreground": "#0070aa"
      }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#b06000",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation"],
      "settings": {
        "foreground": "#5a6070"
      }
    },
    {
      "name": "Punctuation Accessor",
      "scope": ["punctuation.accessor", "punctuation.separator.dot-access"],
      "settings": {
        "foreground": "#0070aa"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#c0003a",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Support Constant",
      "scope": ["support.constant"],
      "settings": {
        "foreground": "#b06000"
      }
    },
    {
      "name": "JSON Key Level 0",
      "scope": ["source.json meta.structure.dictionary.json support.type.property-name.json"],
      "settings": {
        "foreground": "#b5006e"
      }
    },
    {
      "name": "JSON Key Level 1",
      "scope": ["source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"],
      "settings": {
        "foreground": "#7c3aed"
      }
    },
    {
      "name": "JSON Key Level 2",
      "scope": ["source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"],
      "settings": {
        "foreground": "#0070aa"
      }
    },
    {
      "name": "CSS Property",
      "scope": ["support.type.property-name.css"],
      "settings": {
        "foreground": "#3a6680"
      }
    },
    {
      "name": "CSS Value",
      "scope": ["support.constant.property-value.css"],
      "settings": {
        "foreground": "#1e7a44"
      }
    },
    {
      "name": "CSS Selector",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": {
        "foreground": "#b06000"
      }
    },
    {
      "name": "Markdown Heading",
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#0d8a52",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#b06000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#7c3aed",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#1e7a44"
      }
    },
    {
      "name": "Markdown Link",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#0070aa",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#909aa8",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#1e7a44",
    "type": "#0094a8",
    "type.declaration": { "foreground": "#b06000" },
    "class": "#b06000",
    "class.declaration": { "foreground": "#b06000" },
    "enum": "#b5006e",
    "interface": { "foreground": "#0094a8", "fontStyle": "italic" },
    "typeParameter": "#0094a8",
    "parameter": { "foreground": "#2c2f36", "fontStyle": "italic" },
    "variable": "#2c2f36",
    "variable.readonly": { "foreground": "#b5006e" },
    "variable.defaultLibrary": "#0094a8",
    "property": "#3a6680",
    "property.readonly": { "foreground": "#b5006e" },
    "property.declaration": "#3a6680",
    "enumMember": "#b5006e",
    "event": "#0070aa",
    "function": "#0070aa",
    "function.defaultLibrary": "#0094a8",
    "method": "#0070aa",
    "macro": "#7c3aed",
    "keyword": { "foreground": "#7c3aed", "fontStyle": "italic" },
    "modifier": { "foreground": "#7c3aed", "fontStyle": "italic" },
    "comment": { "foreground": "#909aa8", "fontStyle": "italic" },
    "string": "#1e7a44",
    "number": "#b06000",
    "regexp": "#0094a8",
    "operator": "#0070aa",
    "decorator": { "foreground": "#0070aa", "fontStyle": "italic" },
    "parameter.declaration": { "foreground": "#2c2f36", "fontStyle": "italic" }
  }
}